# ===============================================
# Environment Variables Template
# ===============================================
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# cp .env.example .env
#
# หมายเหตุ: ใน Lovable Preview จะใช้ fallback อัตโนมัติ
# ตั้งค่าเหล่านี้เฉพาะตอน deploy จริง (Vercel, Netlify, etc.)
# ===============================================

# ========== Firebase ==========
# สร้างที่: Firebase Console → Project Settings → General → Your apps → Web
VITE_FIREBASE_API_KEY=           # Firebase API Key
VITE_FIREBASE_AUTH_DOMAIN=       # เช่น your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=        # เช่น your-project
VITE_FIREBASE_STORAGE_BUCKET=    # เช่น your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=  # ตัวเลข เช่น 186347234458
VITE_FIREBASE_APP_ID=            # เช่น 1:186347234458:web:xxxxx
VITE_FIREBASE_MEASUREMENT_ID=   # เช่น G-XXXXXXXXXX (ไม่บังคับ)

# ========== App ==========
VITE_APP_NAME=HightXClient       # ชื่อแอป
VITE_APP_ENV=development          # development | production

# ========== Supabase / Lovable Cloud (auto-generated, ห้ามแก้ไข) ==========
# ค่าเหล่านี้ถูกตั้งให้อัตโนมัติโดย Lovable Cloud
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_PROJECT_ID=

# ===============================================
# Supabase / Lovable Cloud Secrets
# ===============================================
# ตั้งค่าผ่าน Lovable Settings → Secrets (ไม่ใส่ในไฟล์ .env)
#
# FIREBASE_SERVICE_ACCOUNT       — JSON จาก Firebase Console → Project Settings → Service accounts → Generate new private key
# THUNDER_API_KEY                — API Key จาก thunder.byshield.com
# ===============================================

# ===============================================
# ตั้งค่าในหน้า Admin (ไม่ต้องใส่ในไฟล์ .env)
# ===============================================
# Thunder API Key                — Admin → ตั้งค่าระบบ → Thunder API
# Discord Webhook URLs           — Admin → Webhook Settings
# Bank Account Info              — Admin → ตั้งค่าระบบ → ข้อมูลบัญชีธนาคาร
# TrueWallet Phone               — Admin → ตั้งค่าระบบ → เบอร์รับเงิน TrueWallet
# ===============================================
